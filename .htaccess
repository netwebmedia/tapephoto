# tapephoto.com — Apache 2.4

Options -Indexes

# Branded error page. Without this Apache serves its own 236-byte
# "Error 404 - Not Found": no branding, no nav, no link back, so every stale
# inbound link is a guaranteed bounce. Same pattern already live on dongaston,
# marpolis and entrepoker.
ErrorDocument 404 /404.html

# Never serve dotfiles (.cpanel.yml, .git*, editor droppings). FilesMatch tests
# the filename only, so /.well-known/<token> ACME challenges still resolve.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

RewriteEngine On

# Force HTTPS + canonical non-www host
# (non-www is required: the NetWebMedia forms API CORS allowlist
#  only accepts https://tapephoto.com)
# ACME HTTP-01 challenges (cPanel AutoSSL) are exempt — never redirect them.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://tapephoto.com/$1 [L,R=301]

# Extension-less top-level paths (e.g. /services) 404'd while /blog (no
# extension either) correctly 301'd to /blog/ — that asymmetry was just
# Apache's own mod_dir DirectorySlash firing for a real directory, with
# nothing equivalent for a bare path whose real file is <name>.html.
# Redirect (not an internal rewrite) so /services.html — the URL every
# canonical tag and internal link already uses — stays the one indexable
# copy (audit-fix LOW, 2026-09-01).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^.]+)$ /$1.html [R=301,L,QSA]

# Cache policy: images 1 year immutable, HTML never cached,
# CSS/JS short cache with revalidation
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# Security headers
#
# Added 2026-08-01 after a portfolio audit found tapephoto.com serving ZERO
# security headers — no HSTS, no nosniff, no framing policy, no referrer
# policy — while the canonical-host redirects above were already working. The
# redirect half of this file was right; the header half was simply absent.
#
# No 'preload' and no 'includeSubDomains' on HSTS: subdomain usage on this
# domain isn't audited, and preload is effectively irreversible.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Added 2026-09-02 (Don Gaston scorecard "Fix first"): the site uses none of
  # these browser features, so deny them outright; also stops any third-party
  # script that ever lands here from asking for them.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Enforced CSP (not Report-Only). Audited 2026-08-18 over every page in this
  # repo AND the live blog output, because the blog machine publishes here
  # unattended and its pages are what a repo-only audit would miss.
  #
  # This policy is FULLY STRICT — no 'unsafe-inline' anywhere — which this site
  # can afford because it has zero executable inline script, zero on*= handlers,
  # zero style="" attributes and zero <style> blocks. The only inline <script>
  # tags are type="application/ld+json"; those are data blocks the browser never
  # executes, so script-src does not apply to them and the structured data keeps
  # working. Keep it that way: adding one inline handler or one style="" here
  # breaks silently under this header.
  #
  # connect-src carries netwebmedia.com because THE CONTACT FORM POSTS THERE —
  # main.js sends to https://netwebmedia.com/api/public/forms/submit. Drop that
  # origin and the form fails with a console error and no lead, which is this
  # site's only conversion path. It is not decoration.
  #
  # js/analytics.js injects gtag at runtime, so googletagmanager needs script-src
  # and the collect beacon + pixel need connect-src and img-src. All three are
  # required — miss one and GA4 reports nothing while the page looks perfect.
  # Google Fonts moved in-house on 2026-09-02 (/fonts/, @font-face at the top
  # of style.css) so the critical path has no third-party origin. The
  # fonts.googleapis.com / fonts.gstatic.com allowances stay: they cost
  # nothing and protect any page or blog post that still carries the old link.
  #
  # Outbound links (instagram.com, facebook.com, wa.me) are anchor hrefs, not
  # resource loads, so they need no entry here.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://netwebmedia.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# The FTP deploy action (SamKirkland/FTP-Deploy-Action) writes its sync-state
# file into the docroot: a JSON inventory of every deployed path + hash. It was
# web-readable (sibling property climalerta.com served it 200 on 2026-09-01).
# The action reads it back over FTP, so an HTTP 404 costs deploys nothing.
RedirectMatch 404 (^|/)\.ftp-deploy-sync-state
