# tapephoto.com — Apache 2.4

Options -Indexes

# Never serve dotfiles (.cpanel.yml, .git*, editor droppings). FilesMatch tests
# the filename only, so /.well-known/<token> ACME challenges still resolve.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

RewriteEngine On

# Force HTTPS + canonical non-www host
# (non-www is required: the NetWebMedia forms API CORS allowlist
#  only accepts https://tapephoto.com)
# ACME HTTP-01 challenges (cPanel AutoSSL) are exempt — never redirect them.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://tapephoto.com/$1 [L,R=301]

# Cache policy: images 1 year immutable, HTML never cached,
# CSS/JS short cache with revalidation
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# Security headers
#
# Added 2026-08-01 after a portfolio audit found tapephoto.com serving ZERO
# security headers — no HSTS, no nosniff, no framing policy, no referrer
# policy — while the canonical-host redirects above were already working. The
# redirect half of this file was right; the header half was simply absent.
#
# No 'preload' and no 'includeSubDomains' on HSTS: subdomain usage on this
# domain isn't audited, and preload is effectively irreversible.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
